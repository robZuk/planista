{
  "name": "planista7-backend",
  "version": "0.1.0",
  "description": "Planista6 - backend (Express + TypeScript + Prisma)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
