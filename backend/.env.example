# Skopiuj ten plik do .env i uzupelnij wartosci.

# Port serwera backendu
PORT=4001

# Adres frontendu (do CORS)
CORS_ORIGIN=http://localhost:5174

# Polaczenie do bazy.
# - natywnie (npm run dev): Postgres na hoscie, port 5434 (mapowanie z docker-compose).
# - w kontenerze (docker compose): host to nazwa uslugi 'db' na porcie 5432 —
#   ta wartosc jest ustawiana w docker-compose.yml, nie tutaj.
DATABASE_URL="postgresql://postgres:password@localhost:5434/planista7?schema=public"

# Sekrety JWT — w produkcji uzyj dlugich, losowych wartosci
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
