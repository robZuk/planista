# Skopiuj do .env.prod (poza repo) i ustaw MOCNE, losowe sekrety przed prod.
# Uzywany przez docker-compose.prod.yml (env_file) dla uslugi backend.

# Sekrety JWT — w prod dlugie, losowe wartosci (np. `openssl rand -base64 48`).
JWT_ACCESS_SECRET=zmien-mnie-na-losowy-sekret
JWT_REFRESH_SECRET=zmien-mnie-na-inny-losowy-sekret

# Origin frontu do CORS. Przy jednym origin (nginx podaje front i proxuje /api)
# CORS i tak nie jest krytyczny, ale ustaw pod swoja domene.
CORS_ORIGIN=http://localhost:8080

# Error-tracking (Better Stack — SDK Sentry-kompatybilne). DSN z panelu
# (Error tracking -> aplikacja -> DSN). Pusty/brak = error-tracking wylaczony.
# To sekret — trzymaj tylko tutaj (plik poza repo), nigdy w kodzie.
SENTRY_DSN=
# Opcjonalnie: SHA commita, zeby przypiac bledy do konkretnego deployu.
# GIT_SHA=
